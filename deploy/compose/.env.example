# Copy to .env and edit. Lines starting with # are optional unless the comment says "required".
# Generate secrets with:  openssl rand -hex 32

# --- Required: secrets ---------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# Signs sessions and the daily visitor hash. 32+ characters.
DOCKUDOS_SESSION_SECRET=

# --- Where it runs -------------------------------------------------------------------------------------------------------
# The URL people type for the dashboard (also the webhook base URL your Git host calls).
DOCKUDOS_PUBLIC_URL=http://localhost:8080
# Built sites are served at <slug>.<this>. Must not be the dashboard's host or a parent of it.
DOCKUDOS_SITES_DOMAIN=sites.localhost
# What the proxy listens for (see Caddyfile). Use https:// names for a real deployment.
DOCKUDOS_PLATFORM_ADDRESS=http://localhost
DOCKUDOS_SITES_ADDRESS=http://*.sites.localhost
DOCKUDOS_HTTP_PORT=8080

# --- Git host (at least one, to connect repositories) -------------------------------------------------------------------
# A token that can read the repositories, and create branches, commits and pull requests for the editor and the agent.
# GitHub: a fine-grained token with Contents + Pull requests (read/write) and Commit statuses (write).
# GitLab: a project or personal access token with api scope.
DOCKUDOS_GITHUB_TOKEN=
DOCKUDOS_GITLAB_TOKEN=
# For GitHub Enterprise or a self-hosted GitLab:
#DOCKUDOS_GITHUB_API_URL=https://github.example.com/api/v3
#DOCKUDOS_GITLAB_API_URL=https://gitlab.example.com/api/v4

# --- Sign-in (OpenID Connect). Without it only API keys work. -----------------------------------------------------------
#DOCKUDOS_OIDC_ISSUER=https://accounts.example.com
#DOCKUDOS_OIDC_CLIENT_ID=dockudos
#DOCKUDOS_OIDC_CLIENT_SECRET=
# The first person to sign in with this email owns the instance. Without it, the very first person does.
#DOCKUDOS_ADMIN_EMAIL=you@example.com
# Also sign people in to private docs: the DOCKUDOS_AUTH_SECRET of your docs sites, and a cookie domain they share.
#DOCKUDOS_DOCS_AUTH_SECRET=
#DOCKUDOS_COOKIE_DOMAIN=.example.com

# --- Docs agent (bring your own model) ----------------------------------------------------------------------------------
#DOCKUDOS_LLM_PROVIDER=anthropic        # or openai
#DOCKUDOS_LLM_MODEL=
#DOCKUDOS_LLM_API_KEY=

# --- Analytics privacy ---------------------------------------------------------------------------------------------------
# Off by default: assistant questions are counted, not stored. Turn on to see which questions went unanswered.
#DOCKUDOS_ANALYTICS_LOG_CONVERSATIONS=false
#DOCKUDOS_ANALYTICS_RETENTION_DAYS=90
#DOCKUDOS_CONVERSATION_RETENTION_DAYS=30

# --- Tuning --------------------------------------------------------------------------------------------------------------
#DOCKUDOS_LOG_LEVEL=info
#DOCKUDOS_WORKER_CONCURRENCY=2
#DOCKUDOS_DB_POOL_MAX=10
#DOCKUDOS_METRICS_TOKEN=
# Hosts the platform may call besides your Git hosts (anything private or unlisted is refused).
#DOCKUDOS_FETCH_ALLOW_HOSTS=
