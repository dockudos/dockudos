{
  "name": "@dockudos/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "nx dev @dockudos/docs",
    "dev:example": "nx dev @dockudos/example",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test-ci",
    "e2e": "nx e2e @dockudos/example",
    "e2e:visual": "nx e2e-visual @dockudos/example",
    "check": "nx run-many -t lint typecheck test-ci build",
    "check:affected": "nx affected -t lint typecheck test-ci build e2e",
    "graph": "nx graph",
    "release": "nx release --dry-run",
    "local-registry": "nx local-registry",
    "schema": "node tools/generate-schema.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "lint:commits": "commitlint --from origin/main --to HEAD",
    "verify:packages": "node tools/verify-packages.mjs",
    "verify:init": "node tools/verify-init.mjs",
    "verify:platform": "node tools/verify-platform.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:helm": "node tools/verify-helm.mjs",
    "eval:agent": "node tools/eval-agent-live.mjs"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@dockudos/core": "workspace:*",
    "@dockudos/platform": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/next": "^23.2.1",
    "@nx/vite": "^23.2.1",
    "@nx/vitest": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.2.1",
    "postcss": "^8.5.28",
    "prettier": "~3.6.2",
    "sass": "1.97.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "^6.3.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19"
  }
}
