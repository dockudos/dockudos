  "logo": {
    "light": "/logo-light.svg",
    "dark": "/logo-dark.svg"
  },
  "favicon": "/icon.svg",
  "kudos": {
    "enabled": true
  },
  "actions": {
    "copyPage": true,
    "assistants": true,
    "editUrl": "https://github.com/dockudos/dockudos/edit/main/apps/docs/docs/{file}"
  },
  "icons": {
    "packs": {
      "dockudos": "icons/dockudos"
    }
  },
  "redirects": [
    {
      "source": "/components/steps-and-cards",
      "destination": "/components/steps"
    },
    {
      "source": "/components/tooltip-and-banner",
      "destination": "/components/tooltip"
    },
    {
      "source": "/components/tile-and-colors",
      "destination": "/components/tile"
    },
    {
      "source": "/components/badges-and-keys",
      "destination": "/components/badge"
    },
    {
      "source": "/components/layout-blocks",
      "destination": "/components/columns"
    },
    {
      "source": "/components/api-blocks",
      "destination": "/components/endpoint"
    },
    {
      "source": "/components/copy-text-and-hero",
      "destination": "/components/copy-text"
    },
    {
      "source": "/components/panel-and-examples",
      "destination": "/components/panel"
    },
    {
      "source": "/components/type-tables",
      "destination": "/components/type-table"
    },
    {
      "source": "/components/page-data",
      "destination": "/components/inline-toc"
    },
    {
      "source": "/components/version-labels",
      "destination": "/components/since"
    },
    {
      "source": "/components/tutorial",
      "destination": "/components/tutorial-intro"
    },
    {
      "source": "/components/files",
      "destination": "/components/tree"
    }
  ]
