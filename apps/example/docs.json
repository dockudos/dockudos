{
  "name": "Example Docs",
  "seo": {
    "siteUrl": "https://docs.example.com"
  },
  "redirects": [
    {
      "source": "/old-hello",
      "destination": "/guides/hello"
    }
  ],
  "navigation": [
    {
      "tab": "Guides",
      "groups": [
        {
          "group": "Get started",
          "pages": [
            "index",
            "guides/hello",
            "guides/features",
            "guides/components",
            "guides/code",
            "guides/api"
          ]
        }
      ]
    }
  ],
  "theme": {
    "primary": "#3b82f6"
  },
  "kudos": {
    "enabled": true
  },
  "actions": {
    "copyPage": true,
    "assistants": true,
    "editUrl": "https://github.com/example/site/edit/main/docs/{file}"
  },
  "access": {
    "rules": [
      {
        "paths": ["/print"],
        "require": "basic",
        "realm": "Example docs"
      },
      {
        "paths": ["/private/**"],
        "require": "basic",
        "realm": "Example docs"
      },
      {
        "paths": ["/api/status"],
        "require": "token"
      }
    ]
  }
}
