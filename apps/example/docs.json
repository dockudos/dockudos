{
  "name": "Example Docs",
  "seo": {
    "siteUrl": "https://docs.example.com"
  },
  "redirects": [
    {
      "source": "/old-hello",
      "destination": "/guides/hello"
    }
  ],
  "navigation": [
    {
      "tab": "Guides",
      "groups": [
        {
          "group": "Get started",
          "pages": [
            "index",
            "guides/hello",
            "guides/features",
            "guides/components",
            "guides/code",
            "guides/api"
          ]
        },
        {
          "group": "Acme API",
          "pages": [
            "guides/authentication",
            "guides/pagination",
            "guides/rate-limits",
            "guides/webhooks",
            "guides/billing",
            "guides/troubleshooting"
          ]
        }
      ]
    },
    {
      "tab": "API reference",
      "groups": [
        {
          "group": "Petstore",
          "pages": [
            {
              "openapi": "petstore"
            }
          ]
        }
      ]
    }
  ],
  "theme": {
    "primary": "#3b82f6"
  },
  "kudos": {
    "enabled": true
  },
  "actions": {
    "copyPage": true,
    "assistants": true,
    "editUrl": "https://github.com/example/site/edit/main/docs/{file}"
  },
  "access": {
    "rules": [
      {
        "paths": ["/print"],
        "require": "basic",
        "realm": "Example docs"
      },
      {
        "paths": ["/private/**"],
        "require": "basic",
        "realm": "Example docs"
      },
      {
        "paths": ["/api/status"],
        "require": "token"
      }
    ]
  },
  "icons": {
    "packs": {
      "acme": "icons/acme",
      "mono": {
        "dir": "icons/mono",
        "monochrome": true
      }
    }
  },
  "ai": {
    "enabled": true,
    "provider": "openai",
    "model": "e2e-model",
    "baseUrl": "http://127.0.0.1:4399/v1",
    "limits": {
      "ratePerMinute": 30
    },
    "allowedOrigins": ["http://127.0.0.1:4390"]
  },
  "openapi": {
    "sources": [
      {
        "name": "petstore",
        "spec": "openapi.json",
        "path": "api-reference"
      }
    ],
    "playground": {
      "allowedHosts": ["127.0.0.1:4398"]
    }
  }
}
