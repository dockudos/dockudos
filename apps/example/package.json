{
  "name": "@dockudos/example",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/example/src",
    "tags": [
      "scope:app"
    ],
    "targets": {
      "e2e": {
        "command": "playwright test --project=chromium",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "e2e-visual": {
        "command": "playwright test --project=visual",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@dockudos/core": "workspace:*",
    "@dockudos/next": "workspace:*",
    "@dockudos/ui": "workspace:*"
  },
  "devDependencies": {}
}
