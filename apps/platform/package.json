{
  "name": "@dockudos/platform-app",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/platform/src",
    "tags": [
      "scope:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ]
      },
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      },
      "test-ci": {
        "dependsOn": [
          "^build"
        ]
      },
      "e2e": {
        "command": "playwright test --project=chromium",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@dockudos/core": "workspace:*",
    "@dockudos/ui": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dockudos/platform": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "@dockudos/next": "workspace:*"
  }
}
