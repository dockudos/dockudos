{
  "name": "@dockudos/core",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dockudos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "@dockudos/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./docs.schema.json": "./docs.schema.json"
  },
  "files": [
    "dist",
    "docs.schema.json",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "github-slugger": "^2.0.0",
    "tslib": "^2.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "nx": {
    "tags": [
      "scope:core"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
