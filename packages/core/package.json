{
  "name": "@dockudos/core",
  "version": "0.0.1",
  "description": "Headless core of dockudos: docs.json schema, page tree, navigation, link checking. No React.",
  "license": "Apache-2.0",
  "keywords": [
    "docs",
    "documentation",
    "mdx",
    "headless"
  ],
  "homepage": "https://github.com/dockudos/dockudos#readme",
  "bugs": {
    "url": "https://github.com/dockudos/dockudos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dockudos/dockudos.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dockudos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "@dockudos/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./docs.schema.json": "./docs.schema.json"
  },
  "files": [
    "dist",
    "docs.schema.json",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "github-slugger": "^2.0.0",
    "tslib": "^2.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "nx": {
    "tags": [
      "scope:core"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
