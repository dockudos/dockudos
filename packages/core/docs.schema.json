{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "urlPrefix": {
      "type": "string",
      "pattern": "^\\/[^/]+(?:\\/[^/]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "logo": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "light": {
              "type": "string",
              "minLength": 1
            },
            "dark": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "light",
            "dark"
          ],
          "additionalProperties": false
        }
      ]
    },
    "favicon": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "default": {
        "mode": "system",
        "layout": "docs"
      },
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "mode": {
          "default": "system",
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "layout": {
          "default": "docs",
          "type": "string",
          "enum": [
            "docs",
            "notebook",
            "spacious",
            "flux",
            "glass",
            "home"
          ]
        },
        "fonts": {
          "type": "object",
          "properties": {
            "sans": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^<>{};\\\\]+$"
            },
            "mono": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^<>{};\\\\]+$"
            }
          },
          "additionalProperties": false
        },
        "radius": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<>{};\\\\]+$"
        },
        "css": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "navigation": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "tab": {
                "type": "string",
                "minLength": 1
              },
              "groups": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "required": [
              "tab",
              "groups"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "tab": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "tab",
              "href"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "redirects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          },
          "destination": {
            "type": "string"
          },
          "permanent": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "destination"
        ],
        "additionalProperties": false
      }
    },
    "seo": {
      "default": {
        "noindex": false
      },
      "type": "object",
      "properties": {
        "siteUrl": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "noindex": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "kudos": {
      "default": {
        "enabled": false,
        "endpoint": "/api/kudos"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "endpoint": {
          "default": "/api/kudos",
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*"
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "default": {
        "copyPage": false,
        "assistants": false,
        "endpoint": "/api/markdown"
      },
      "type": "object",
      "properties": {
        "copyPage": {
          "default": false,
          "type": "boolean"
        },
        "assistants": {
          "default": false,
          "type": "boolean"
        },
        "endpoint": {
          "default": "/api/markdown",
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*"
        },
        "editUrl": {
          "type": "string",
          "pattern": "^https?:\\/\\/.*\\{(file|path)\\}"
        }
      },
      "additionalProperties": false
    },
    "search": {
      "default": {
        "backend": "builtin",
        "limit": 10
      },
      "type": "object",
      "properties": {
        "backend": {
          "default": "builtin",
          "type": "string",
          "enum": [
            "builtin",
            "server",
            "custom"
          ]
        },
        "endpoint": {
          "type": "string",
          "pattern": "^(\\/|https?:\\/\\/)"
        },
        "limit": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "additionalProperties": false
    },
    "ai": {
      "default": {
        "enabled": false,
        "endpoint": "/api/ask",
        "navigateEndpoint": "/api/navigate",
        "allowedOrigins": [],
        "navigation": true,
        "limits": {
          "maxQuestionLength": 500,
          "maxOutputTokens": 800,
          "ratePerMinute": 10,
          "maxHistoryTurns": 6,
          "contextTokens": 3000
        }
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "custom"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "default": "/api/ask",
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*"
        },
        "navigateEndpoint": {
          "default": "/api/navigate",
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*"
        },
        "allowedOrigins": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?:\\/\\/[^/\\s?#]+$"
          }
        },
        "navigation": {
          "default": true,
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string",
          "pattern": "^https?:\\/\\/\\S+$"
        },
        "embeddings": {
          "type": "object",
          "properties": {
            "provider": {
              "default": "openai",
              "type": "string",
              "enum": [
                "openai"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "baseUrl": {
              "type": "string",
              "pattern": "^https?:\\/\\/\\S+$"
            },
            "dimensions": {
              "type": "integer",
              "minimum": 8,
              "maximum": 8192
            }
          },
          "required": [
            "model"
          ],
          "additionalProperties": false
        },
        "limits": {
          "default": {
            "maxQuestionLength": 500,
            "maxOutputTokens": 800,
            "ratePerMinute": 10,
            "maxHistoryTurns": 6,
            "contextTokens": 3000
          },
          "type": "object",
          "properties": {
            "maxQuestionLength": {
              "default": 500,
              "type": "integer",
              "minimum": 20,
              "maximum": 4000
            },
            "maxOutputTokens": {
              "default": 800,
              "type": "integer",
              "minimum": 50,
              "maximum": 8000
            },
            "ratePerMinute": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "maxHistoryTurns": {
              "default": 6,
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "contextTokens": {
              "default": 3000,
              "type": "integer",
              "minimum": 200,
              "maximum": 32000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shortcuts": {
      "default": true,
      "type": "boolean"
    },
    "icons": {
      "default": {
        "packs": {}
      },
      "type": "object",
      "properties": {
        "packs": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "dir": {
                    "type": "string",
                    "minLength": 1
                  },
                  "monochrome": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "dir"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "access": {
      "default": {
        "rules": []
      },
      "type": "object",
      "properties": {
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\/(?:[^*\\s]*(?:\\*\\*)?)?$|^\\/(?:[^*\\s/]+|\\*)(?:\\/(?:[^*\\s/]+|\\*))*(?:\\/\\*\\*)?$"
                }
              },
              "require": {
                "type": "string",
                "enum": [
                  "basic",
                  "token",
                  "custom",
                  "deny"
                ]
              },
              "secretEnv": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "realm": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "paths",
              "require"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "openapi": {
      "default": {
        "sources": [],
        "playground": {
          "enabled": true,
          "proxy": false,
          "allowedHosts": []
        }
      },
      "type": "object",
      "properties": {
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "spec": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][\\w-]*(?:\\/[A-Za-z0-9][\\w-]*)*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "openapi",
                  "asyncapi",
                  "graphql"
                ]
              },
              "groupBy": {
                "default": "tag",
                "type": "string",
                "enum": [
                  "tag",
                  "path"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "spec"
            ],
            "additionalProperties": false
          }
        },
        "playground": {
          "default": {
            "enabled": true,
            "proxy": false,
            "allowedHosts": []
          },
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "proxy": {
              "default": false,
              "type": "boolean"
            },
            "allowedHosts": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "default": {
        "sources": []
      },
      "type": "object",
      "properties": {
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "typescript",
                  "python"
                ]
              },
              "input": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][\\w-]*(?:\\/[A-Za-z0-9][\\w-]*)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "type",
              "input"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "tutorial": {
          "type": "boolean"
        },
        "pages": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "href": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "title",
                  "href"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "openapi": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                },
                "required": [
                  "openapi"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                },
                "required": [
                  "reference"
                ],
                "additionalProperties": false
              },
              {
                "$ref": "#/$defs/__schema0"
              }
            ]
          }
        }
      },
      "required": [
        "group",
        "pages"
      ],
      "additionalProperties": false
    }
  }
}
