{
  "name": "@dockudos/next",
  "version": "0.0.1",
  "description": "Next.js integration for dockudos: withDocs(), the MDX pipeline, metadata, sitemap.",
  "license": "Apache-2.0",
  "keywords": [
    "docs",
    "documentation",
    "mdx",
    "nextjs"
  ],
  "homepage": "https://github.com/dockudos/dockudos#readme",
  "bugs": {
    "url": "https://github.com/dockudos/dockudos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dockudos/dockudos.git",
    "directory": "packages/next"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dockudos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "@dockudos/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "@dockudos/source": "./src/client.tsx",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./katex.css": "./katex.css",
    "./mdx-components": {
      "@dockudos/source": "./src/mdx-components.ts",
      "types": "./dist/mdx-components.d.ts",
      "import": "./dist/mdx-components.js",
      "default": "./dist/mdx-components.js"
    },
    "./kudos": {
      "@dockudos/source": "./src/kudos.ts",
      "types": "./dist/kudos.d.ts",
      "import": "./dist/kudos.js",
      "default": "./dist/kudos.js"
    },
    "./markdown": {
      "@dockudos/source": "./src/markdown.ts",
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./access": {
      "@dockudos/source": "./src/access.ts",
      "types": "./dist/access.d.ts",
      "import": "./dist/access.js",
      "default": "./dist/access.js"
    },
    "./api": {
      "@dockudos/source": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./llms": {
      "@dockudos/source": "./src/llms.ts",
      "types": "./dist/llms.d.ts",
      "import": "./dist/llms.js",
      "default": "./dist/llms.js"
    }
  },
  "files": [
    "dist",
    "katex.css",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@dockudos/core": "workspace:*",
    "@dockudos/ui": "workspace:*",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.3.8",
    "@shikijs/rehype": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "@shikijs/twoslash": "^4.5.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "image-size": "^2.0.4",
    "katex": "^0.19.0",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-math": "^3.0.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tslib": "^2.3.0",
    "twoslash": "^0.3.9",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/katex": "^0.16.8",
    "@types/mdx": "^2.0.14",
    "@types/unist": "^3.0.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19.0.0",
    "typescript": ">=5"
  },
  "nx": {
    "tags": [
      "scope:next"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
