{
  "name": "@dockudos/ui",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@dockudos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./components/*": {
      "@dockudos/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "@dockudos/source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src/styles",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@dockudos/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "tags": [
      "scope:ui"
    ],
    "targets": {
      "build-css": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/build-css.mjs",
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/scripts/build-css.mjs"
        ],
        "outputs": [
          "{projectRoot}/dist/styles.css"
        ],
        "cache": true
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
