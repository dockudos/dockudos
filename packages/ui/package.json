{
  "name": "@dockudos/ui",
  "version": "0.0.1",
  "description": "React components, layouts and theme for dockudos documentation sites.",
  "license": "Apache-2.0",
  "keywords": [
    "docs",
    "documentation",
    "mdx",
    "react",
    "components"
  ],
  "homepage": "https://github.com/dockudos/dockudos#readme",
  "bugs": {
    "url": "https://github.com/dockudos/dockudos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dockudos/dockudos.git",
    "directory": "packages/ui"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@dockudos/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./components/*": {
      "@dockudos/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "@dockudos/source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./package.json": "./package.json",
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "src/styles",
    "styles.d.ts",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dockudos/core": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "nx": {
    "tags": [
      "scope:ui"
    ],
    "targets": {
      "build-css": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/build-css.mjs",
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "{projectRoot}/src/**/*",
          "{projectRoot}/scripts/build-css.mjs"
        ],
        "outputs": [
          "{projectRoot}/dist/styles.css"
        ],
        "cache": true
      },
      "build": {
        "dependsOn": [
          "^build",
          "build-css"
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
